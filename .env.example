# Obtain this from your Paystack dashboard. Do not commit the real value.
PAYSTACK_SECRET_KEY=replace_with_your_paystack_secret

# Use "mock" on a computer; use "real" only on the Raspberry Pi shelf controller.
GPIO_MODE=mock
UNLOCK_DURATION_SECONDS=5

# YouTube Mode: "api", "normal", or "both" (default)
# - "api": Uses YouTube Data API v3 (requires YOUTUBE_API_KEY) to fetch playlist videos directly
# - "normal": Uses standard YouTube IFrame API playlist embed (no API key needed)
# - "both": Attempts API mode first; falls back to normal IFrame playlist embed if API fails or key is unset
YOUTUBE_MODE=both

# Optional: Google / YouTube Data API v3 key
YOUTUBE_API_KEY=


